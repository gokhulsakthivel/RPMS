# ============================================================================
# RPMS Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env — it contains secrets.
# ============================================================================

# --- Storage backend --------------------------------------------------------
# "csv"    (default) — reads/writes local CSV files in ./data/
# "sheets" — reads/writes a Google Spreadsheet via Sheets API v4
RPMS_STORAGE=csv

# --- CSV backend (only when RPMS_STORAGE=csv) -------------------------------
# Absolute path to the data directory. Defaults to ./data
# RPMS_DATA_DIR=./data

# --- Google Sheets backend (only when RPMS_STORAGE=sheets) ------------------
# 1. Create a Google Cloud project → enable Sheets API
# 2. Create a Service Account → download JSON key
# 3. Share your spreadsheet with the service account email (Editor role)
# 4. Create one tab per table: loco_pilots, assistant_loco_pilots, trains,
#    assignments, assignment_drafts, leaves
# 5. Run: npx tsx scripts/csv-to-sheets.ts   (to seed data from CSVs)

# The spreadsheet ID from the URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
# GOOGLE_SHEETS_ID=

# The service account email (e.g. rpms@my-project.iam.gserviceaccount.com)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The full PEM private key from the JSON key file.
# Paste it as-is — the server handles \n escaping.
# GOOGLE_PRIVATE_KEY=

# --- Server -----------------------------------------------------------------
PORT=3001

# --- CORS (GitHub Pages deployment) -----------------------------------------
# Comma-separated list of allowed origins.
# CORS_ORIGIN=https://gokhulsakthivel.github.io

# --- GitHub Pages build (set by CI, not needed locally) ---------------------
# GITHUB_PAGES=true
# VITE_API_URL=https://your-api-host.onrender.com
